     return stripped
 
 
+# Words that name a CATEGORY of person rather than a person: indefinite
+# pronouns and unnamed collectives. Deliberately NOT merged into
+# PLACEHOLDER_VALUES — that list is shared by every optional text field, and
+# "someone has to own the release" is a perfectly good rationale. This rule is
+# about one field only.
+_NON_SPECIFIC_OWNER_WORDS: frozenset[str] = frozenset({
+    "someone", "somebody", "anyone", "anybody", "everyone", "everybody",
+    "no", "noone", "nobody", "one", "whoever", "who",
+    "team", "teams", "group", "squad", "crew", "folks", "people", "person",
+    "persons", "staff", "all", "both", "each", "every", "several", "many",
+    "multiple", "various", "other", "others", "someones",
+    "we", "us", "they", "them", "you", "i", "me", "myself", "ourselves",
+    "themselves", "owner", "owners", "assignee", "somebody's",
+})
+
+# Words that carry no identity by themselves, so they neither make an owner
+# specific nor make it vague: "the whole team" and "the rest of the team" are
+# the same nobody as "team".
+_OWNER_FILLER_WORDS: frozenset[str] = frozenset({
+    "the", "a", "an", "our", "my", "your", "their", "his", "her", "its",
+    "whole", "entire", "rest", "of", "on", "in", "from", "and", "or",
+    "else", "involved", "responsible", "relevant", "available", "here",
+})
+
+_OWNER_WORD = re.compile(r"[^\w']+")
+
+
+def normalize_owner(value: str | None) -> str | None:
+    """`normalize_optional_text`, plus: a category of person is not an owner.
+
+    The model is told to emit null when the notes name nobody. Sometimes it
+    copies the notes' own indefinite wording instead — "someone should chase
+    the vendor invoice this week" came back as owner="someone", and another
+    meeting produced owner="the team". Those are non-empty strings, so every
+    blank check downstream read them as a confirmed owner, the structural gap
+    never fired, and the gate opened on a follow-up that told a team "someone"
+    was chasing their invoice. An owner nobody agreed to is precisely what the
+    gate exists to stop, and a vague one is no better than an invented one.
+
+    The rule: strip the filler words, then if every word that remains is a
+    generic category word, the string names nobody. A NAMED group survives —
+    "Platform Team" keeps "platform", which is specific — because the product
+    asks for an owner a human confirmed, not for a human being.
+
+    Deliberately over-inclusive at the margins: a false block asks a manager a
+    question, a false pass sends a message naming someone who never agreed.
+    """
+    owner = normalize_optional_text(value)
+    if owner is None:
+        return None
+    words = [w for w in _OWNER_WORD.split(owner.lower()) if w]
+    content = [w for w in words if w not in _OWNER_FILLER_WORDS]
+    # `all()` on an empty list is True, which is the wanted answer: an owner of
+    # "the" or "!!!" has no content words and names nobody either.
+    if all(word in _NON_SPECIFIC_OWNER_WORDS for word in content):
+        return None
+    return owner
+
+
